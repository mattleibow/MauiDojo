<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiDojo.Agent.Maui.Controls"
             xmlns:templates="clr-namespace:MauiDojo.Agent.Maui.Templates"
             xmlns:converters="clr-namespace:MauiDojo.Agent.Maui.Converters"
             x:Class="MauiDojo.Agent.Maui.Controls.ChatControl"
             x:Name="Root">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBool" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

            <DataTemplate x:Key="DefaultUserTemplate">
                <templates:UserMessageTemplate />
            </DataTemplate>
            <DataTemplate x:Key="DefaultAssistantTemplate">
                <templates:AssistantMessageTemplate />
            </DataTemplate>

            <templates:MessageTemplateSelector x:Key="DefaultMessageTemplateSelector"
                UserMessageTemplate="{StaticResource DefaultUserTemplate}"
                AssistantMessageTemplate="{StaticResource DefaultAssistantTemplate}" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

        <!-- Header -->
        <Grid Grid.Row="0"
              Padding="12,8"
              ColumnDefinitions="*,Auto"
              BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1E1E1E}">
            <Label Text="Chat"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="New Chat"
                    FontSize="13"
                    Padding="12,6"
                    CornerRadius="8"
                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                    TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"
                    Clicked="OnNewChatClicked" />
        </Grid>

        <!-- Messages list -->
        <CollectionView x:Name="MessagesCollection"
                        Grid.Row="1"
                        ItemTemplate="{StaticResource DefaultMessageTemplateSelector}"
                        Margin="0"
                        VerticalOptions="Fill">
            <CollectionView.Header>
                <BoxView HeightRequest="8" Color="Transparent" />
            </CollectionView.Header>
            <CollectionView.Footer>
                <BoxView HeightRequest="8" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- Pending messages (streaming) + loading indicator -->
        <VerticalStackLayout Grid.Row="2"
                             Spacing="0">
            <CollectionView x:Name="PendingMessagesCollection"
                            ItemTemplate="{StaticResource DefaultMessageTemplateSelector}" />

            <controls:AgentLoadingIndicator x:Name="LoadingIndicator"
                                            Margin="12,4"
                                            HorizontalOptions="Start" />
        </VerticalStackLayout>

        <!-- Suggestion bar -->
        <controls:SuggestionBar Grid.Row="3"
                                x:Name="SuggestionBarControl"
                                Suggestions="{Binding Suggestions, Source={x:Reference Root}}"
                                SuggestionTapped="{Binding SuggestionTappedCommand, Source={x:Reference Root}}" />

        <!-- Input area -->
        <Border Grid.Row="4"
                Padding="8"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1E1E1E}">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Editor x:Name="InputEditor"
                        AutoSize="TextChanges"
                        MaximumHeightRequest="120"
                        FontSize="15"
                        Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                        Completed="OnInputCompleted" />

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Text="➤"
                        FontSize="20"
                        WidthRequest="48"
                        HeightRequest="48"
                        CornerRadius="24"
                        Padding="0"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        VerticalOptions="End"
                        Clicked="OnSendClicked" />
            </Grid>
        </Border>

    </Grid>

</ContentView>
