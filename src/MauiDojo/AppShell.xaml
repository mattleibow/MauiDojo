<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:demos="clr-namespace:MauiDojo.Views.Demos"
       x:Class="MauiDojo.AppShell"
       Title="MAUI Dojo"
       Shell.FlyoutBehavior="Locked"
       FlyoutWidth="280"
       FlyoutHeaderBehavior="Fixed">

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="16" BackgroundColor="#6366F1">
            <Label Text="🥋 MAUI Dojo"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White" />
            <Label Text="AG-UI Demo Scenarios"
                   FontSize="14"
                   TextColor="White"
                   Opacity="0.8" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <ShellContent Title="💬 Agentic Chat" Route="AgenticChat"
                  ContentTemplate="{DataTemplate demos:AgenticChatPage}" />

    <ShellContent Title="🌤️ Backend Tool Rendering" Route="BackendToolRendering"
                  ContentTemplate="{DataTemplate demos:BackendToolRenderingPage}" />

    <ShellContent Title="🙋 Human in the Loop" Route="HumanInTheLoop"
                  ContentTemplate="{DataTemplate demos:HumanInTheLoopPage}" />

    <ShellContent Title="📊 Agentic Generative UI" Route="AgenticGenerativeUI"
                  ContentTemplate="{DataTemplate demos:AgenticGenerativeUIPage}" />

    <ShellContent Title="🎋 Tool-Based Generative UI" Route="ToolBasedGenerativeUI"
                  ContentTemplate="{DataTemplate demos:ToolBasedGenerativeUIPage}" />

    <ShellContent Title="🍳 Shared State" Route="SharedState"
                  ContentTemplate="{DataTemplate demos:SharedStatePage}" />

    <ShellContent Title="📝 Predictive State Updates" Route="PredictiveStateUpdates"
                  ContentTemplate="{DataTemplate demos:PredictiveStateUpdatesPage}" />

</Shell>
