<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiDojo.ViewModels"
             xmlns:services="clr-namespace:MauiDojo.Agent.Maui.Services;assembly=MauiDojo.Agent.Maui"
             xmlns:agentMaui="clr-namespace:MauiDojo.Agent.Maui;assembly=MauiDojo.Agent.Maui"
             xmlns:models="clr-namespace:MauiDojo.Models"
             x:Class="MauiDojo.Views.Demos.HumanInTheLoopPage"
             x:DataType="vm:HumanInTheLoopViewModel"
             Title="Human in the Loop">

    <Grid RowDefinitions="*,Auto,Auto,Auto" Padding="0">

        <!-- Chat messages -->
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Session.Messages}"
                        Margin="0,8,0,0"
                        ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:ChatMessageViewModel">
                    <Grid Padding="16,4">
                        <Frame IsVisible="{Binding IsUser}"
                               BackgroundColor="{StaticResource UserMessageBg}"
                               BorderColor="Transparent"
                               CornerRadius="16"
                               Padding="14,10"
                               HorizontalOptions="End"
                               MaximumWidthRequest="400"
                               HasShadow="False">
                            <Label Text="{Binding Text}"
                                   TextColor="{StaticResource UserMessageText}"
                                   FontSize="14" />
                        </Frame>

                        <Frame IsVisible="{Binding IsAssistant}"
                               BackgroundColor="{StaticResource AssistantMessageBg}"
                               BorderColor="Transparent"
                               CornerRadius="16"
                               Padding="14,10"
                               HorizontalOptions="Start"
                               MaximumWidthRequest="400"
                               HasShadow="False">
                            <Label Text="{Binding Text}"
                                   TextColor="{StaticResource AssistantMessageText}"
                                   FontSize="14" />
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Plan confirmation card -->
        <Frame Grid.Row="1"
               IsVisible="{Binding IsAwaitingConfirmation}"
               Style="{StaticResource CardFrame}"
               Margin="16,8"
               Padding="16">
            <VerticalStackLayout Spacing="12">
                <Label Text="📋 Review Plan"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" />

                <Label Text="Select the steps you'd like to execute:"
                       FontSize="13"
                       TextColor="{StaticResource TextSecondary}" />

                <CollectionView ItemsSource="{Binding CurrentPlan.Steps}"
                                HeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Step">
                            <Grid ColumnDefinitions="Auto,*" Padding="4" ColumnSpacing="8">
                                <CheckBox Grid.Column="0"
                                          IsChecked="True"
                                          Color="{StaticResource Primary}"
                                          VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding Description}"
                                       FontSize="14"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource TextPrimary}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0"
                            Text="✅ Confirm Selected"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ConfirmPlanCommand}" />
                    <Button Grid.Column="1"
                            Text="❌ Reject"
                            BackgroundColor="{StaticResource Error}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            Padding="16,12"
                            Command="{Binding RejectPlanCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <!-- Suggestions + processing indicator -->
        <VerticalStackLayout Grid.Row="2" Spacing="8" Padding="16,8">
            <ActivityIndicator IsRunning="{Binding Session.IsProcessing}"
                               IsVisible="{Binding Session.IsProcessing}"
                               Color="{StaticResource Primary}"
                               HeightRequest="24" />

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Suggestions}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="agentMaui:Suggestion">
                            <Button Text="{Binding Text}"
                                    Style="{StaticResource SuggestionButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HumanInTheLoopViewModel}}, Path=SendSuggestionCommand}"
                                    CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <!-- Input area -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Padding="16,8,16,16" ColumnSpacing="8">
            <Editor Grid.Column="0"
                    Text="{Binding InputText}"
                    Placeholder="Describe a task to plan..."
                    Style="{StaticResource ChatEditor}"
                    HeightRequest="44"
                    AutoSize="TextChanges"
                    MaximumHeightRequest="120" />
            <Button Grid.Column="1"
                    Text="Send"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SendMessageCommand}"
                    VerticalOptions="End" />
        </Grid>
    </Grid>
</ContentPage>
