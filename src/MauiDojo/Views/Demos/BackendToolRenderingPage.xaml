<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:local="clr-namespace:MauiDojo.Converters"
             xmlns:templates="clr-namespace:MauiDojo.Views.Templates"
             x:Class="MauiDojo.Views.Demos.BackendToolRenderingPage"
             Title="Backend Tool Rendering">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InverseBoolConverter" />
        <local:BoolToColorConverter x:Key="BoolToColorConverter" />
        <local:BoolToTextColorConverter x:Key="BoolToTextColorConverter" />

        <!-- User message bubble -->
        <DataTemplate x:Key="UserMessageTemplate">
            <Frame Margin="4,2" Padding="12,8" CornerRadius="12" HasShadow="False"
                   BackgroundColor="{Binding IsUser, Converter={StaticResource BoolToColorConverter}}">
                <Label Text="{Binding Text}"
                       TextColor="{Binding IsUser, Converter={StaticResource BoolToTextColorConverter}}" />
            </Frame>
        </DataTemplate>

        <!-- Assistant text bubble -->
        <DataTemplate x:Key="AssistantTextTemplate">
            <Frame Margin="4,2" Padding="12,8" CornerRadius="12" HasShadow="False"
                   BackgroundColor="#F3F4F6">
                <Label Text="{Binding Text}" TextColor="#212121" />
            </Frame>
        </DataTemplate>

        <!-- Inline weather card (rendered inside the message list) -->
        <DataTemplate x:Key="WeatherCardTemplate">
            <templates:InlineWeatherCardView />
        </DataTemplate>

        <!-- Default: minimal view for messages with no displayable content -->
        <DataTemplate x:Key="DefaultMessageTemplate">
            <ContentView />
        </DataTemplate>

        <templates:ChatMessageTemplateSelector x:Key="MessageTemplateSelector"
            UserMessageTemplate="{StaticResource UserMessageTemplate}"
            AssistantTextTemplate="{StaticResource AssistantTextTemplate}"
            WeatherCardTemplate="{StaticResource WeatherCardTemplate}"
            DefaultTemplate="{StaticResource DefaultMessageTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto,Auto">

        <!-- Messages list with inline weather cards -->
        <CollectionView Grid.Row="0" x:Name="MessagesView" Margin="8"
                        ItemsSource="{Binding Session.Messages}" SelectionMode="None"
                        ItemTemplate="{StaticResource MessageTemplateSelector}">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                    <Label Text="🌤️" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Ask about the weather" FontSize="16" TextColor="Gray" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Suggestions -->
        <HorizontalStackLayout Grid.Row="1" Spacing="8" Margin="8,4"
                               IsVisible="{Binding Session.IsProcessing, Converter={StaticResource InverseBoolConverter}}">
            <Button Text="Weather in San Francisco" Clicked="OnSuggestionClicked"
                    FontSize="12" Padding="12,6" CornerRadius="16"
                    BackgroundColor="#F3F4F6" TextColor="#6366F1" />
            <Button Text="Weather in New York" Clicked="OnSuggestionClicked"
                    FontSize="12" Padding="12,6" CornerRadius="16"
                    BackgroundColor="#F3F4F6" TextColor="#6366F1" />
            <Button Text="Weather in Tokyo" Clicked="OnSuggestionClicked"
                    FontSize="12" Padding="12,6" CornerRadius="16"
                    BackgroundColor="#F3F4F6" TextColor="#6366F1" />
        </HorizontalStackLayout>

        <!-- Input area -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="8" ColumnSpacing="8">
            <Entry x:Name="InputEntry" Placeholder="Ask about the weather..."
                   IsEnabled="{Binding Session.IsProcessing, Converter={StaticResource InverseBoolConverter}}" />
            <Button Grid.Column="1" Text="Send" Clicked="OnSendClicked"
                    BackgroundColor="#6366F1" TextColor="White" CornerRadius="8" />
        </Grid>
    </Grid>
</ContentPage>