<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiDojo.ViewModels"
             xmlns:services="clr-namespace:MauiDojo.Agent.Maui.Services;assembly=MauiDojo.Agent.Maui"
             xmlns:agent="clr-namespace:MauiDojo.Agent.Maui;assembly=MauiDojo.Agent.Maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiDojo.Views.Demos.ToolBasedGenerativeUIPage"
             x:DataType="vm:ToolBasedGenerativeUIViewModel"
             Title="Tool-Based Generative UI"
             BackgroundColor="{StaticResource BackgroundLight}">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Padding="0">

        <!-- Haiku Carousel Area -->
        <Grid Grid.Row="0" Padding="16" MinimumHeightRequest="260">

            <!-- Placeholder when no haikus -->
            <Frame IsVisible="{Binding HasHaikus, Converter={StaticResource InvertedBoolConverter}}"
                   Style="{StaticResource CardFrame}"
                   Padding="24"
                   HorizontalOptions="Fill">
                <Frame.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#667eea" Offset="0.0" />
                        <GradientStop Color="#764ba2" Offset="1.0" />
                    </LinearGradientBrush>
                </Frame.Background>
                <VerticalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="🎋"
                           FontSize="48"
                           HorizontalOptions="Center" />
                    <Label Text="Your haikus will appear here"
                           FontSize="16"
                           TextColor="White"
                           Opacity="0.9"
                           HorizontalOptions="Center" />
                    <Label Text="Ask the AI to write a haiku to get started"
                           FontSize="13"
                           TextColor="White"
                           Opacity="0.7"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Current Haiku Card -->
            <Grid IsVisible="{Binding HasHaikus}" RowDefinitions="*,Auto">
                <Frame Grid.Row="0"
                       Style="{StaticResource CardFrame}"
                       Padding="24"
                       HorizontalOptions="Fill"
                       BackgroundColor="{Binding CurrentHaikuBackgroundColor}">
                    <VerticalStackLayout Spacing="16" VerticalOptions="Center">
                        <!-- Japanese text -->
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center"
                                             BindableLayout.ItemsSource="{Binding CurrentHaiku.Japanese}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}"
                                           FontSize="28"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalTextAlignment="Center" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="White" Opacity="0.3"
                                 HorizontalOptions="Fill" Margin="40,0" />

                        <!-- English translation -->
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center"
                                             BindableLayout.ItemsSource="{Binding CurrentHaiku.English}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}"
                                           FontSize="15"
                                           TextColor="White"
                                           Opacity="0.85"
                                           FontAttributes="Italic"
                                           HorizontalTextAlignment="Center" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Navigation controls -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Padding="8,8,8,0">
                    <Button Grid.Column="0"
                            Text="◀"
                            Command="{Binding PreviousHaikuCommand}"
                            IsEnabled="{Binding HasPreviousHaiku}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            FontSize="20"
                            WidthRequest="44" HeightRequest="44" />
                    <Label Grid.Column="1"
                           Text="{Binding HaikuPosition}"
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                    <Button Grid.Column="2"
                            Text="▶"
                            Command="{Binding NextHaikuCommand}"
                            IsEnabled="{Binding HasNextHaiku}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            FontSize="20"
                            WidthRequest="44" HeightRequest="44" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Chat Messages -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Session.Messages}"
                        ItemsUpdatingScrollMode="KeepLastItemInView"
                        Margin="8,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:ChatMessageViewModel">
                    <VerticalStackLayout Padding="4,4">
                        <!-- User message -->
                        <Frame IsVisible="{Binding IsUser}"
                               BackgroundColor="{StaticResource UserMessageBg}"
                               BorderColor="Transparent"
                               CornerRadius="12"
                               Padding="12,8"
                               HorizontalOptions="End"
                               Margin="48,0,0,0">
                            <Label Text="{Binding Text}"
                                   TextColor="{StaticResource UserMessageText}"
                                   FontSize="14" />
                        </Frame>
                        <!-- Assistant message -->
                        <Frame IsVisible="{Binding IsAssistant}"
                               BackgroundColor="{StaticResource AssistantMessageBg}"
                               BorderColor="Transparent"
                               CornerRadius="12"
                               Padding="12,8"
                               HorizontalOptions="Start"
                               Margin="0,0,48,0">
                            <Label Text="{Binding Text}"
                                   TextColor="{StaticResource AssistantMessageText}"
                                   FontSize="14" />
                        </Frame>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Pending / streaming messages -->
        <VerticalStackLayout Grid.Row="2"
                             BindableLayout.ItemsSource="{Binding Session.PendingMessages}"
                             Margin="8,0">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="services:ChatMessageViewModel">
                    <Frame BackgroundColor="{StaticResource AssistantMessageBg}"
                           BorderColor="Transparent"
                           CornerRadius="12"
                           Padding="12,8"
                           HorizontalOptions="Start"
                           Margin="0,4,48,4">
                        <Label Text="{Binding Text}"
                               TextColor="{StaticResource AssistantMessageText}"
                               FontSize="14" />
                    </Frame>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <!-- Suggestions -->
        <FlexLayout Grid.Row="3"
                    Direction="Row" Wrap="Wrap" JustifyContent="Start"
                    Margin="12,4"
                    BindableLayout.ItemsSource="{Binding Suggestions}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="agent:Suggestion">
                    <Button Text="{Binding Text}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ToolBasedGenerativeUIViewModel}}, Path=SendSuggestionCommand}"
                            CommandParameter="{Binding .}"
                            Style="{StaticResource SuggestionButton}"
                            Margin="4" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

        <!-- Input Area -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Padding="12,8" ColumnSpacing="8">
            <Editor Text="{Binding UserMessage}"
                    Placeholder="Ask for a haiku..."
                    Style="{StaticResource ChatEditor}"
                    HeightRequest="44"
                    MaximumHeightRequest="100"
                    AutoSize="TextChanges" />
            <Button Grid.Column="1"
                    Text="Send"
                    Command="{Binding SendCommand}"
                    Style="{StaticResource PrimaryButton}" />
        </Grid>

    </Grid>
</ContentPage>
