<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiDojo.ViewModels"
             xmlns:services="clr-namespace:MauiDojo.Agent.Maui.Services;assembly=MauiDojo.Agent.Maui"
             xmlns:agent="clr-namespace:MauiDojo.Agent.Maui;assembly=MauiDojo.Agent.Maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiDojo.Views.Demos.PredictiveStateUpdatesPage"
             x:DataType="vm:PredictiveStateUpdatesViewModel"
             Title="Predictive State Updates"
             BackgroundColor="{StaticResource BackgroundLight}">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="0">

        <!-- LEFT: Document Viewer -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Padding="16">

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <Label Grid.Column="0" Text="📝 Document Editor" Style="{StaticResource PageTitle}" />
                <HorizontalStackLayout Grid.Column="1"
                                       IsVisible="{Binding IsStreaming}"
                                       Spacing="6"
                                       VerticalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsStreaming}"
                                       Color="{StaticResource Primary}"
                                       HeightRequest="16" WidthRequest="16" />
                    <Label Text="✍️ Writing..."
                           FontSize="13"
                           TextColor="{StaticResource Primary}"
                           FontAttributes="Italic"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Document Content -->
            <Frame Grid.Row="1"
                   Style="{StaticResource CardFrame}"
                   Padding="20">
                <Grid>
                    <!-- Empty placeholder -->
                    <VerticalStackLayout IsVisible="{Binding HasDocument, Converter={StaticResource InvertedBoolConverter}}"
                                         Spacing="8"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center">
                        <Label Text="📄" FontSize="48" HorizontalTextAlignment="Center" />
                        <Label Text="Ask the AI to write something..."
                               FontSize="15"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Document text -->
                    <ScrollView IsVisible="{Binding HasDocument}">
                        <Label Text="{Binding CurrentDocument.Document}"
                               FontSize="15"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               Padding="4" />
                    </ScrollView>
                </Grid>
            </Frame>

            <!-- Confirmation Overlay -->
            <Frame Grid.Row="2"
                   IsVisible="{Binding IsAwaitingConfirmation}"
                   BackgroundColor="{StaticResource BackgroundCard}"
                   BorderColor="{StaticResource BorderLight}"
                   CornerRadius="12"
                   Padding="16"
                   Margin="0,12,0,0"
                   HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Review Changes"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="The AI has proposed changes to the document. Would you like to accept or reject them?"
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalTextAlignment="Center" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Text="✓ Accept Changes"
                                Command="{Binding AcceptChangesCommand}"
                                BackgroundColor="{StaticResource Success}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8" />
                        <Button Grid.Column="1"
                                Text="✕ Reject Changes"
                                Command="{Binding RejectChangesCommand}"
                                BackgroundColor="{StaticResource Error}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </Grid>

        <!-- RIGHT: Chat Panel -->
        <Grid Grid.Column="1"
              RowDefinitions="*,Auto,Auto,Auto"
              BackgroundColor="{StaticResource BackgroundCard}"
              Padding="0">

            <BoxView Grid.RowSpan="4" WidthRequest="1" HorizontalOptions="Start"
                     Color="{StaticResource BorderLight}" />

            <!-- Chat Messages -->
            <CollectionView Grid.Row="0"
                            ItemsSource="{Binding Session.Messages}"
                            ItemsUpdatingScrollMode="KeepLastItemInView"
                            Margin="8,8,8,0">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="24">
                        <Label Text="📝" FontSize="36" HorizontalTextAlignment="Center" />
                        <Label Text="Ask the AI to write something..."
                               FontSize="14"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:ChatMessageViewModel">
                        <VerticalStackLayout Padding="4,4">
                            <Frame IsVisible="{Binding IsUser}"
                                   BackgroundColor="{StaticResource UserMessageBg}"
                                   BorderColor="Transparent"
                                   CornerRadius="12"
                                   Padding="12,8"
                                   HorizontalOptions="End"
                                   Margin="48,0,0,0">
                                <Label Text="{Binding Text}"
                                       TextColor="{StaticResource UserMessageText}"
                                       FontSize="14" />
                            </Frame>
                            <Frame IsVisible="{Binding IsAssistant}"
                                   BackgroundColor="{StaticResource AssistantMessageBg}"
                                   BorderColor="Transparent"
                                   CornerRadius="12"
                                   Padding="12,8"
                                   HorizontalOptions="Start"
                                   Margin="0,0,48,0">
                                <Label Text="{Binding Text}"
                                       TextColor="{StaticResource AssistantMessageText}"
                                       FontSize="14" />
                            </Frame>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Pending messages -->
            <VerticalStackLayout Grid.Row="1"
                                 BindableLayout.ItemsSource="{Binding Session.PendingMessages}"
                                 Margin="8,0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="services:ChatMessageViewModel">
                        <Frame BackgroundColor="{StaticResource AssistantMessageBg}"
                               BorderColor="Transparent"
                               CornerRadius="12"
                               Padding="12,8"
                               HorizontalOptions="Start"
                               Margin="0,4,48,4">
                            <Label Text="{Binding Text}"
                                   TextColor="{StaticResource AssistantMessageText}"
                                   FontSize="14" />
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Suggestions -->
            <FlexLayout Grid.Row="2"
                        Direction="Row" Wrap="Wrap" JustifyContent="Start"
                        Margin="12,4"
                        BindableLayout.ItemsSource="{Binding Suggestions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="agent:Suggestion">
                        <Button Text="{Binding Text}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PredictiveStateUpdatesViewModel}}, Path=SendSuggestionCommand}"
                                CommandParameter="{Binding .}"
                                Style="{StaticResource SuggestionButton}"
                                Margin="4" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- Input Area -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Padding="12,8" ColumnSpacing="8">
                <Editor Text="{Binding UserMessage}"
                        Placeholder="Ask the AI to write or edit..."
                        Style="{StaticResource ChatEditor}"
                        HeightRequest="44"
                        MaximumHeightRequest="100"
                        AutoSize="TextChanges" />
                <Button Grid.Column="1"
                        Text="Send"
                        Command="{Binding SendCommand}"
                        Style="{StaticResource PrimaryButton}" />
            </Grid>
        </Grid>

    </Grid>
</ContentPage>
