<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiDojo.ViewModels"
             xmlns:models="clr-namespace:MauiDojo.Models"
             xmlns:services="clr-namespace:MauiDojo.Agent.Maui.Services;assembly=MauiDojo.Agent.Maui"
             xmlns:agent="clr-namespace:MauiDojo.Agent.Maui;assembly=MauiDojo.Agent.Maui"
             x:Class="MauiDojo.Views.Demos.SharedStatePage"
             x:DataType="vm:SharedStateViewModel"
             Title="Shared State"
             BackgroundColor="{StaticResource BackgroundLight}">

    <Grid ColumnDefinitions="*,*" ColumnSpacing="0">

        <!-- LEFT: Recipe Form -->
        <ScrollView Grid.Column="0">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Label Text="🍳 Recipe Editor" Style="{StaticResource PageTitle}" />

                <!-- Title -->
                <Label Text="Recipe Title" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                <Entry Text="{Binding RecipeTitle}"
                       Placeholder="Recipe title"
                       FontSize="16"
                       BackgroundColor="{StaticResource BackgroundCard}" />

                <!-- Cooking Time Picker -->
                <Label Text="Cooking Time" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                <Picker Title="Select cooking time"
                        SelectedItem="{Binding CookingTime}"
                        ItemsSource="{Binding AvailableCookingTimes}"
                        BackgroundColor="{StaticResource BackgroundCard}" />

                <!-- Skill Level Picker -->
                <Label Text="Skill Level" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                <Picker Title="Select skill level"
                        SelectedItem="{Binding SkillLevel}"
                        ItemsSource="{Binding AvailableSkillLevels}"
                        BackgroundColor="{StaticResource BackgroundCard}" />

                <!-- Dietary Preferences -->
                <Label Text="Dietary Preferences" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start"
                            BindableLayout.ItemsSource="{Binding AvailablePreferences}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Text="{Binding .}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SharedStateViewModel}}, Path=TogglePreferenceCommand}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource SuggestionButton}"
                                    Margin="4" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- Ingredients -->
                <Label Text="Ingredients" Style="{StaticResource SectionHeader}" />
                <CollectionView ItemsSource="{Binding Ingredients}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Ingredient">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Padding="4,4">
                                <Label Grid.Column="0"
                                       Text="{Binding Icon}"
                                       FontSize="20"
                                       VerticalTextAlignment="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding Name}"
                                       Placeholder="Ingredient"
                                       FontSize="14"
                                       BackgroundColor="{StaticResource BackgroundCard}" />
                                <Entry Grid.Column="2"
                                       Text="{Binding Amount}"
                                       Placeholder="Amount"
                                       FontSize="14"
                                       WidthRequest="80"
                                       BackgroundColor="{StaticResource BackgroundCard}" />
                                <Button Grid.Column="3"
                                        Text="✕"
                                        TextColor="{StaticResource Error}"
                                        BackgroundColor="Transparent"
                                        FontSize="16"
                                        WidthRequest="36" HeightRequest="36"
                                        Padding="0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SharedStateViewModel}}, Path=RemoveIngredientCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button Text="+ Add Ingredient"
                        Command="{Binding AddIngredientCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        FontSize="14"
                        HorizontalOptions="Start" />

                <!-- Instructions -->
                <Label Text="Instructions" Style="{StaticResource SectionHeader}" />
                <CollectionView ItemsSource="{Binding Instructions}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="4,4">
                                <Label Grid.Column="0"
                                       Text="{Binding .}"
                                       FontSize="14"
                                       VerticalTextAlignment="Center"
                                       LineBreakMode="WordWrap" />
                                <Button Grid.Column="1"
                                        Text="✕"
                                        TextColor="{StaticResource Error}"
                                        BackgroundColor="Transparent"
                                        FontSize="16"
                                        WidthRequest="36" HeightRequest="36"
                                        Padding="0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SharedStateViewModel}}, Path=RemoveInstructionCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button Text="+ Add Step"
                        Command="{Binding AddInstructionCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        FontSize="14"
                        HorizontalOptions="Start" />

                <!-- Improve with AI -->
                <Button Text="✨ Improve with AI"
                        Command="{Binding ImproveWithAICommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalOptions="Fill"
                        Margin="0,8" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- RIGHT: Chat Panel -->
        <Grid Grid.Column="1"
              RowDefinitions="*,Auto,Auto,Auto"
              BackgroundColor="{StaticResource BackgroundCard}"
              Padding="0">

            <BoxView Grid.RowSpan="4" WidthRequest="1" HorizontalOptions="Start"
                     Color="{StaticResource BorderLight}" />

            <!-- Chat Messages -->
            <CollectionView Grid.Row="0"
                            ItemsSource="{Binding Session.Messages}"
                            ItemsUpdatingScrollMode="KeepLastItemInView"
                            Margin="8,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:ChatMessageViewModel">
                        <VerticalStackLayout Padding="4,4">
                            <Frame IsVisible="{Binding IsUser}"
                                   BackgroundColor="{StaticResource UserMessageBg}"
                                   BorderColor="Transparent"
                                   CornerRadius="12"
                                   Padding="12,8"
                                   HorizontalOptions="End"
                                   Margin="48,0,0,0">
                                <Label Text="{Binding Text}"
                                       TextColor="{StaticResource UserMessageText}"
                                       FontSize="14" />
                            </Frame>
                            <Frame IsVisible="{Binding IsAssistant}"
                                   BackgroundColor="{StaticResource AssistantMessageBg}"
                                   BorderColor="Transparent"
                                   CornerRadius="12"
                                   Padding="12,8"
                                   HorizontalOptions="Start"
                                   Margin="0,0,48,0">
                                <Label Text="{Binding Text}"
                                       TextColor="{StaticResource AssistantMessageText}"
                                       FontSize="14" />
                            </Frame>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Pending messages -->
            <VerticalStackLayout Grid.Row="1"
                                 BindableLayout.ItemsSource="{Binding Session.PendingMessages}"
                                 Margin="8,0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="services:ChatMessageViewModel">
                        <Frame BackgroundColor="{StaticResource AssistantMessageBg}"
                               BorderColor="Transparent"
                               CornerRadius="12"
                               Padding="12,8"
                               HorizontalOptions="Start"
                               Margin="0,4,48,4">
                            <Label Text="{Binding Text}"
                                   TextColor="{StaticResource AssistantMessageText}"
                                   FontSize="14" />
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Suggestions -->
            <FlexLayout Grid.Row="2"
                        Direction="Row" Wrap="Wrap" JustifyContent="Start"
                        Margin="12,4"
                        BindableLayout.ItemsSource="{Binding Suggestions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="agent:Suggestion">
                        <Button Text="{Binding Text}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SharedStateViewModel}}, Path=SendSuggestionCommand}"
                                CommandParameter="{Binding .}"
                                Style="{StaticResource SuggestionButton}"
                                Margin="4" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- Input Area -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Padding="12,8" ColumnSpacing="8">
                <Editor Text="{Binding UserMessage}"
                        Placeholder="Chat about the recipe..."
                        Style="{StaticResource ChatEditor}"
                        HeightRequest="44"
                        MaximumHeightRequest="100"
                        AutoSize="TextChanges" />
                <Button Grid.Column="1"
                        Text="Send"
                        Command="{Binding SendCommand}"
                        Style="{StaticResource PrimaryButton}" />
            </Grid>
        </Grid>

    </Grid>
</ContentPage>
